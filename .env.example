# ────────────────────────────────────────────────────────────────
# PROPERTY OS — Environment Variables
# ────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it's in .gitignore.

# ── AI APIs ─────────────────────────────────────────────────────
# Google Gemini (used by Sofía IA for WhatsApp reply generation)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OpenAI (used for 1536d vector embeddings via text-embedding-3-small)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# ── Supabase (Backend) ───────────────────────────────────────────
# Direct connection string for Drizzle ORM migrations & server-side queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase project URL (also used as VITE_ prefix for browser access)
VITE_SUPABASE_URL="https://lqagnlbygzurddkzbbwn.supabase.co"

# Supabase public anon key (safe for browser — used by supabase-js Auth)
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase service role key (server-side only — bypasses RLS — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ── Evolution API (WhatsApp) ─────────────────────────────────────
# Base URL of your Evolution API instance
EVOLUTION_API_URL="https://evolution.tudominio.com"

# API Key configured in Evolution API (sent as "apikey" header)
EVOLUTION_API_KEY="YOUR_EVOLUTION_API_KEY"

# Instance name in Evolution API corresponding to your WhatsApp number
EVOLUTION_INSTANCE_NAME="PropertyOS-Main"

# ── App ──────────────────────────────────────────────────────────
# Public URL of the deployed app (used for webhooks and self-references)
APP_URL="https://property-app-chi.vercel.app"
