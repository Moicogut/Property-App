# Configuración de Base de Datos y Supabase
VITE_SUPABASE_URL=tu_url_de_supabase_aqui
VITE_SUPABASE_ANON_KEY=tu_anon_key_de_supabase_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Proveedores de Embeddings (Strategy Pattern)
GEMINI_API_KEY=tu_gemini_api_key_aqui
OPENAI_API_KEY=tu_openai_key

# Configuración de WhatsApp Evolution API
EVOLUTION_API_URL=tu_evolution_api_url_aqui
EVOLUTION_API_KEY=tu_evolution_api_key_aqui
EVOLUTION_INSTANCE_NAME=PropertyOS-Main

# Ajustes Generales
NODE_ENV=development

# B2B Prospecting — Google Places API (datos reales de agencias)
# Activar en: https://console.cloud.google.com → APIs → Places API
# $200 crédito gratis/mes, costo real ~$0.50 por escaneo de 15 agencias
GOOGLE_PLACES_API_KEY=tu_google_places_api_key_aqui
